{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "workspaceLayout": {
    "projectNameAndRootFormat": "as-provided",
    "appsDir": "examples",
    "libsDir": "packages"
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/eslint.config.js"
      ],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "cache": true
    },
    "e2e": {
      "inputs": ["default", "^production"],
      "cache": true
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/eslint.config.js",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "sharedGlobals": []
  },
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true
      },
      "library": {}
    },
    "@nx/next": {
      "application": {
        "style": "css",
        "linter": "eslint"
      }
    },
    "@nx/workspace:move": {
      "projectNameAndRootFormat": "as-provided"
    }
  },
  "release": {
    "projects": ["firmhouse-sdk"],
    "projectsRelationship": "independent",
    "releaseTag": {
      "pattern": "{projectName}-v{version}",
      "checkAllBranchesWhen": ["main", "alpha", "beta"]
    },
    "version": {
      "conventionalCommits": true,
      "preVersionCommand": "npx nx run firmhouse-sdk:api-extractor"
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": {
        "createRelease": "github",
        "file": "{projectRoot}/CHANGELOG.md"
      }
    },
    "conventionalCommits": {
      "useCommitScope": false,
      "types": {
        "feat": {
          "semverBump": "minor",
          "changelog": {
            "title": "Features"
          }
        },
        "fix": {
          "semverBump": "patch",
          "changelog": {
            "title": "Bug Fixes"
          }
        },
        "build": {
          "semverBump": "patch",
          "changelog": false
        },
        "ci": {
          "semverBump": "patch",
          "changelog": false
        },
        "chore": {
          "semverBump": "patch",
          "changelog": false
        },
        "docs": {
          "semverBump": "patch",
          "changelog": false
        },
        "refactor": {
          "semverBump": "patch",
          "changelog": false
        },
        "style": {
          "semverBump": "patch",
          "changelog": false
        },
        "test": {
          "semverBump": "patch",
          "changelog": false
        }
      }
    }
  },
  "nxCloudAccessToken": "ZjQwMGFiYWMtYjBmNy00NjRhLThjNzMtNjAxYmU4NDRlODI0fHJlYWQtd3JpdGU=",
  "useInferencePlugins": false,
  "defaultBase": "master",
  "analytics": false
}
